@startuml c4 container task 4

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml


Person(call_center_manager, "Менеджер кол-центра")
Person(partner_operator, "Оператор партнёрского кол-центра")
Person(deposit_manager, "Сотрудник депозитного бэк-офиса")
Person(credit_manager, "Сотрудник кредитного бэк-офиса")

System_Boundary(abs_boundary, "АБС") {
    Container(abs_app, "АБС", "Delphi + PL/SQL", "Ведение и утверждение депозитных ставок")
    ContainerDb(abs_db, "БД АБС", "Oracle", "Клиенты, счета, депозиты, ставки")
}

System_Boundary(rates_boundary, "Контур депозитных ставок") {
    Container(rates_api, "Rates API", "Java Spring Boot", "Предоставляет актуальные ставки сайту, интернет-банку и кол-центру")
    ContainerDb(rates_db, "БД ставок", "MS SQL", "Актуальные ставки, версии и история изменений")
    Container(rates_exporter, "Rates File Exporter", "Java Spring Boot", "Формирует файл со ставками для партнёрского кол-центра")
}

System_Boundary(call_center_boundary, "Система кол-центра") {
    Container(call_center_app, "Система кол-центра", "React.js + Java Spring Boot", "Показывает ставки менеджерам кол-центра")
}

System_Ext(partner_call_center, "Система партнёрского кол-центра", "Внешняя система партнёра")
System(site, "Сайт банка", "PHP + React.js")
System(internet_bank, "Интернет-банк", "ASP.NET MVC / .NET Framework 4.5")

Rel(deposit_manager, abs_app, "Ведёт ставки")
Rel(credit_manager, abs_app, "Согласует ставки")
Rel(abs_app, abs_db, "Читает и сохраняет данные")

Rel(abs_app, rates_api, "Публикует актуальные ставки", "API")
Rel(rates_api, rates_db, "Сохраняет ставки и версии")

Rel(site, rates_api, "Получает ставки", "HTTPS API")
Rel(internet_bank, rates_api, "Получает ставки", "HTTPS API")
Rel(call_center_app, rates_api, "Получает ставки", "HTTPS API")
Rel(call_center_manager, call_center_app, "Консультирует клиента")

Rel(rates_exporter, rates_db, "Читает актуальные ставки")
Rel(rates_exporter, partner_call_center, "Передаёт файл со ставками", "SFTP")
Rel(partner_operator, partner_call_center, "Консультирует клиента")

@enduml